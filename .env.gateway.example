# Gateway-side local config (never commit `.env.gateway`).
# Loaded only by `tools/run_local_gateway.*` and the live gateway subprocess in tests.

OPTIMUS_LOCAL_GATEWAY_PROVIDER=openrouter
OPTIMUS_LOCAL_GATEWAY_PROVIDER_API_KEY=replace-with-your-openrouter-key
OPTIMUS_LOCAL_GATEWAY_SHARED_SECRET=replace-with-local-shared-secret

# Optional overrides:
# OPTIMUS_LOCAL_GATEWAY_BIND_HOST=127.0.0.1
# OPTIMUS_LOCAL_GATEWAY_PORT=8765
# OPTIMUS_LOCAL_GATEWAY_BASE_URL=https://openrouter.ai/api/v1

# Anthropic-native path (secondary):
# OPTIMUS_LOCAL_GATEWAY_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key

# --- Gateway tool providers (Plan 11.3 / Plan 11.2 Task 6) ---
# Required for `build_tool_dependencies()` to return a non-None bundle.
# `optimus-trust run-gateway` projects these into the Gateway child env.
TAVILY_API_KEY=replace-with-your-tavily-key
OPTIMUS_GATEWAY_TOOL_ALLOWED_DOMAINS=python.org,pypi.org,docs.python.org,npmjs.com,registry.npmjs.org,central.sonatype.com,repo1.maven.org,osv.dev,github.com
OPTIMUS_GATEWAY_TOOL_REDIS_URL=redis://127.0.0.1:6379/0

# Optional tool-provider overrides:
# OPTIMUS_GATEWAY_OSV_API_KEY=replace-with-optional-osv-key
# OPTIMUS_GATEWAY_TAVILY_BASE_URL=https://api.tavily.com
# OPTIMUS_GATEWAY_OSV_BASE_URL=https://api.osv.dev
# OPTIMUS_GATEWAY_PYPI_BASE_URL=https://pypi.org
# OPTIMUS_GATEWAY_NPM_BASE_URL=https://registry.npmjs.org
# OPTIMUS_GATEWAY_MAVEN_BASE_URL=https://repo1.maven.org/maven2
# OPTIMUS_GATEWAY_TOOL_MAX_CALLS_PER_TOOL=5
