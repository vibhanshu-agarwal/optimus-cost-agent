# Gateway-side local config (never commit `.env.gateway`).
# Loaded as untrusted key=value data by the retained trust-CLI Gateway ceremony and the
# live gateway subprocess in tests — never sourced into the interactive shell.
# OpenRouter is the approved default model/search upstream. Vercel is a future bounded model
# option pending a modest Python transport check, not a Phase 1 search backend.

# OpenRouter is the only model credential accepted by the Gateway child.
OPTIMUS_LOCAL_GATEWAY_PROVIDER_API_KEY=replace-with-your-openrouter-key
OPTIMUS_LOCAL_GATEWAY_SHARED_SECRET=replace-with-local-shared-secret

# Optional upstream override:
# OPTIMUS_LOCAL_GATEWAY_BASE_URL=https://openrouter.ai/api/v1

# Optional observability export override (Gateway-child-only standard OTel env var;
# no OPTIMUS_LOCAL_GATEWAY_ prefix). Phoenix is the local default; the agent-side
# OptimusGatewaySettings never reads or forwards this variable.
# Local Phoenix mode projects the displayed loopback OTLP reference only to the
# Gateway child; it is never exported into the agent shell. See
# docs/superpowers/plans/2026-07-29-plan-11-6-local-live-dependencies-operator-runbook.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces

# --- Temporary migration-only search configuration ---
# The current implementation still reads TAVILY_API_KEY while the tool bundle is being
# restructured. Do not treat Tavily as the target architecture; remove this variable only after
# the OpenRouter replacement acceptance tests and rollback review pass under P11-FEAT-GATEWAY-TOOLS.
# The trust-CLI Gateway ceremony projects this into the Gateway child env.
TAVILY_API_KEY=replace-with-your-tavily-key
OPTIMUS_GATEWAY_TOOL_ALLOWED_DOMAINS=python.org,pypi.org,docs.python.org,npmjs.com,registry.npmjs.org,central.sonatype.com,repo1.maven.org,github.com,osv.dev,nvd.nist.gov,openwall.com
OPTIMUS_GATEWAY_TOOL_REDIS_URL=redis://127.0.0.1:6379/0

# Optional tool-provider overrides:
# OPTIMUS_GATEWAY_OSV_API_KEY=replace-with-optional-osv-key
# OPTIMUS_GATEWAY_TAVILY_BASE_URL=https://api.tavily.com
# OPTIMUS_GATEWAY_OSV_BASE_URL=https://api.osv.dev
# OPTIMUS_GATEWAY_PYPI_BASE_URL=https://pypi.org
# OPTIMUS_GATEWAY_NPM_BASE_URL=https://registry.npmjs.org
# OPTIMUS_GATEWAY_MAVEN_BASE_URL=https://repo1.maven.org/maven2
# OPTIMUS_GATEWAY_TOOL_MAX_CALLS_PER_TOOL=5

# Note: OSV advisory citations commonly include nvd.nist.gov and openwall.com;
# omit them and real advisory success paths can 403 on URL_DOMAIN_NOT_ALLOWED.
