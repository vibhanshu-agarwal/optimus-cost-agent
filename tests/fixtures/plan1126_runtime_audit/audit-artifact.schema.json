{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimus.local/schemas/plan-11-26-runtime-audit-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "merged_commit", "overlay_commit", "binding_commit", "baseline_reconciliation_status",
    "running_artifact_provenance", "static_audit_status", "runtime_characterization_status", "live_redis_status",
    "acpx_status", "additional_client_status", "zed_status", "live_interoperability_status",
    "unclassified_finding_count", "finding_counts_by_classification", "findings", "discovered_multipliers",
    "computed_run_cost", "gate_status", "evidence_records"
  ],
  "allOf": [{
    "if": {
      "anyOf": [
        {"properties": {"live_redis_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["live_redis_status"]},
        {"properties": {"acpx_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["acpx_status"]},
        {"properties": {"additional_client_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["additional_client_status"]},
        {"properties": {"zed_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["zed_status"]},
        {"properties": {"live_interoperability_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["live_interoperability_status"]}
      ]
    },
    "then": {
      "required": ["binding_commit", "running_artifact_provenance"],
      "properties": {
        "binding_commit": {"$ref": "#/$defs/commit"},
        "running_artifact_provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }, {
    "if": {
      "anyOf": [
        {"properties": {"static_audit_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["static_audit_status"]},
        {"properties": {"runtime_characterization_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["runtime_characterization_status"]}
      ]
    },
    "then": {"properties": {"evidence_records": {"minItems": 1}}}
  }],
  "properties": {
    "schema_version": {"const": "plan-11-26-runtime-audit-v1"},
    "merged_commit": {"$ref": "#/$defs/commit"},
    "overlay_commit": {"$ref": "#/$defs/commit"},
    "binding_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
    "baseline_reconciliation_status": {"type": "string", "minLength": 1},
    "running_artifact_provenance": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/provenance"}]},
    "static_audit_status": {"$ref": "#/$defs/liveStatus"},
    "runtime_characterization_status": {"$ref": "#/$defs/liveStatus"},
    "live_redis_status": {"$ref": "#/$defs/liveStatus"},
    "acpx_status": {"$ref": "#/$defs/liveStatus"},
    "additional_client_status": {"$ref": "#/$defs/liveStatus"},
    "zed_status": {"$ref": "#/$defs/liveStatus"},
    "live_interoperability_status": {"$ref": "#/$defs/liveStatus"},
    "unclassified_finding_count": {"type": "integer", "minimum": 0},
    "finding_counts_by_classification": {
      "type": "object", "additionalProperties": false,
      "required": ["CANONICAL", "CANONICAL_BYPASSED", "DUPLICATED", "CONTRADICTORY", "MISSING", "INTENTIONALLY_EXCEPTIONAL", "PROVISIONAL_OVERLAY", "NOT_PRESENT", "SUPERSEDED", "UNCLASSIFIED"],
      "properties": {
        "CANONICAL": {"type": "integer", "minimum": 0}, "CANONICAL_BYPASSED": {"type": "integer", "minimum": 0},
        "DUPLICATED": {"type": "integer", "minimum": 0}, "CONTRADICTORY": {"type": "integer", "minimum": 0},
        "MISSING": {"type": "integer", "minimum": 0}, "INTENTIONALLY_EXCEPTIONAL": {"type": "integer", "minimum": 0},
        "PROVISIONAL_OVERLAY": {"type": "integer", "minimum": 0}, "NOT_PRESENT": {"type": "integer", "minimum": 0},
        "SUPERSEDED": {"type": "integer", "minimum": 0}, "UNCLASSIFIED": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "discovered_multipliers": {
      "type": "object", "additionalProperties": false,
      "required": ["cancellation_points", "queues", "sinks", "close_paths"],
      "properties": {
        "cancellation_points": {"type": "integer", "minimum": 0}, "queues": {"type": "integer", "minimum": 0},
        "sinks": {"type": "integer", "minimum": 0}, "close_paths": {"type": "integer", "minimum": 0}
      }
    },
    "computed_run_cost": {
      "type": "object", "additionalProperties": false,
      "required": ["cancellation_concurrency_levels", "cancellation_schedules", "cancellation_control_schedules", "queue_admissions", "sink_failure_runs", "idempotent_close_invocations", "scenario_p50_ms", "scenario_p95_ms"],
      "properties": {
        "cancellation_concurrency_levels": {"type": "array", "const": [2, 4, 8]},
        "cancellation_schedules": {"type": "integer", "minimum": 0},
        "cancellation_control_schedules": {"type": "integer", "minimum": 0},
        "queue_admissions": {"type": "integer", "minimum": 0},
        "sink_failure_runs": {"type": "integer", "minimum": 0},
        "idempotent_close_invocations": {"type": "integer", "minimum": 0},
        "scenario_p50_ms": {"$ref": "#/$defs/durations"},
        "scenario_p95_ms": {"$ref": "#/$defs/durations"}
      }
    },
    "gate_status": {"enum": ["PASS", "PASS_WITH_FINDINGS", "INCOMPLETE"]}
    ,"evidence_records": {"type": "array", "items": {"oneOf": [
      {"$ref": "#/$defs/evidenceRecord"},
      {"$ref": "#/$defs/cancellationEvidenceRecord"}
    ]}}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contentFreeText": {"type": "string", "minLength": 1, "pattern": "^(?!.*(?:api[_-]?key|password|passwd|access[_-]?token|refresh[_-]?token|authorization|cookie|secret|response body|prompt body|request body|payload body)\\s*[:=])[^\\u0000-\\u001f\\u007f]+$"},
    "liveStatus": {"enum": ["UNRUN", "PARTIAL", "INVALID", "COMPLETE"]},
    "durations": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "finding": {
      "type": "object", "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"baseline_scope": {"const": "binding"}}, "required": ["baseline_scope"]},
        "then": {"properties": {"evidence": {"items": {"properties": {"baseline_scope": {"const": "binding"}}}}}}
      }],
      "required": ["finding_id", "subject", "classification", "baseline_scope", "symbols", "evidence", "owner", "ruling"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/contentFreeText"}, "subject": {"$ref": "#/$defs/contentFreeText"},
        "classification": {"enum": ["CANONICAL", "CANONICAL_BYPASSED", "DUPLICATED", "CONTRADICTORY", "MISSING", "INTENTIONALLY_EXCEPTIONAL", "PROVISIONAL_OVERLAY", "NOT_PRESENT", "SUPERSEDED", "UNCLASSIFIED"]},
        "baseline_scope": {"enum": ["merged", "overlay", "both-aligned", "both-divergent", "binding"]},
        "symbols": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentFreeText"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "owner": {"$ref": "#/$defs/contentFreeText"}, "ruling": {"$ref": "#/$defs/contentFreeText"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "baseline_scope", "digest"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "baseline_scope": {"enum": ["merged", "overlay", "both-aligned", "both-divergent", "binding"]},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "discoveredSite": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "symbol", "line", "kind", "baseline_scope", "evidence_digest", "classification", "invariant", "reference", "delivery_phase"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["DELIVERY_START", "DELIVERY_PUBLICATION", "DELIVERY_SETTLEMENT"]},
        "baseline_scope": {"enum": ["merged", "overlay", "both-aligned", "both-divergent", "binding"]},
        "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "classification": {"enum": ["CANONICAL", "CANONICAL_BYPASSED", "DUPLICATED", "CONTRADICTORY", "MISSING", "INTENTIONALLY_EXCEPTIONAL", "PROVISIONAL_OVERLAY", "NOT_PRESENT", "SUPERSEDED", "UNCLASSIFIED"]},
        "invariant": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "reference": {"type": "string", "minLength": 1},
        "delivery_phase": {"enum": ["QUEUE_ADMISSION", "PUBLICATION", "PHYSICAL_WRITE", "FLUSH", "CANCELLATION", "FINAL_RESPONSE", "CONVERSATION_COMMIT", "EFFECT_SETTLEMENT"]}
      }
    },
    "contradictionSearch": {
      "type": "object", "additionalProperties": false,
      "required": ["searched_reference_count", "contradictory_site_count", "contradictory_citations", "conclusion"],
      "properties": {
        "searched_reference_count": {"type": "integer", "minimum": 0},
        "contradictory_site_count": {"type": "integer", "minimum": 0},
        "contradictory_citations": {"type": "array", "items": {"$ref": "#/$defs/contentFreeText"}},
        "conclusion": {"$ref": "#/$defs/contentFreeText"}
      }
    },
    "scheduleOperation": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "operation", "citation"],
      "properties": {
        "phase": {"enum": ["QUEUE_ADMISSION", "PUBLICATION", "PHYSICAL_WRITE", "FLUSH", "CANCELLATION", "FINAL_RESPONSE", "CONVERSATION_COMMIT", "EFFECT_SETTLEMENT"]},
        "operation": {"$ref": "#/$defs/contentFreeText"},
        "citation": {"$ref": "#/$defs/contentFreeText"}
      }
    },
    "deliveryObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "seed_source", "anchor_commit", "schedule", "operations", "site_citations", "vocabulary_names", "scenario", "write_attempted", "flush_attempted", "cancellation_timing", "cancellation_result", "primary_conversation_record_count", "send_state", "send_outcome", "settlement", "final_delivery", "rpc_response_delivery", "conversation_commit", "effect_state", "classification", "contradiction", "complete"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "seed_source": {"enum": ["frozen-literal", "commit-derived"]},
        "anchor_commit": {"$ref": "#/$defs/commit"},
        "schedule": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["QUEUE_ADMISSION", "PUBLICATION", "PHYSICAL_WRITE", "FLUSH", "CANCELLATION", "FINAL_RESPONSE", "CONVERSATION_COMMIT", "EFFECT_SETTLEMENT"]}},
        "operations": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/scheduleOperation"}},
        "site_citations": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/contentFreeText"}},
        "vocabulary_names": {"type": "array", "const": ["ConversationCommit", "EffectState", "FinalDelivery", "RpcResponseDelivery", "SendOutcome", "SendState", "Settlement"]},
        "scenario": {"enum": ["success-known-effect", "success-unknown-effect", "preparation-failure", "write-failure", "flush-failure", "session-cancel-before-protocol-write", "cancel-after-publication", "transport-teardown"]},
        "write_attempted": {"type": "boolean"}, "flush_attempted": {"type": "boolean"},
        "cancellation_timing": {"enum": ["before-write", "during-write", "during-flush", "after-publication"]},
        "cancellation_result": {"enum": ["accepted", "ignored_after_cutoff", "not_attempted"]},
        "primary_conversation_record_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "send_state": {"type": "string", "minLength": 1}, "send_outcome": {"type": "string", "minLength": 1},
        "settlement": {"type": "string", "minLength": 1}, "final_delivery": {"type": "string", "minLength": 1},
        "rpc_response_delivery": {"type": "string", "minLength": 1}, "conversation_commit": {"type": "string", "minLength": 1},
        "effect_state": {"type": "string", "minLength": 1},
        "classification": {"enum": ["CANONICAL", "CANONICAL_BYPASSED", "DUPLICATED", "CONTRADICTORY", "MISSING", "INTENTIONALLY_EXCEPTIONAL", "PROVISIONAL_OVERLAY", "NOT_PRESENT", "SUPERSEDED"]},
        "contradiction": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "complete": {"const": true}
      }
    },
    "scheduleObservations": {
      "type": "object", "additionalProperties": false,
      "required": ["literal_seeds", "derived_seed_count", "derived_seed_anchor_commit", "total_observation_count", "complete_observation_count", "observation_closure_status", "vocabulary_coverage_status", "classification_counts", "digest", "vocabulary", "coverage_assessments", "constant_metadata_notes", "observations"],
      "properties": {
        "literal_seeds": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "derived_seed_count": {"type": "integer", "minimum": 0},
        "derived_seed_anchor_commit": {"$ref": "#/$defs/commit"},
        "total_observation_count": {"type": "integer", "minimum": 0},
        "complete_observation_count": {"type": "integer", "minimum": 0},
        "observation_closure_status": {"enum": ["FULLY_STRUCTURALLY_CLOSED"]},
        "vocabulary_coverage_status": {"enum": ["FULLY_OBSERVED", "PARTIAL_WITH_SCOPE_OUTS"]},
        "classification_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["CANONICAL", "CANONICAL_BYPASSED", "DUPLICATED", "CONTRADICTORY", "MISSING", "INTENTIONALLY_EXCEPTIONAL", "PROVISIONAL_OVERLAY", "NOT_PRESENT", "SUPERSEDED", "UNCLASSIFIED"],
          "properties": {
            "CANONICAL": {"type": "integer", "minimum": 0}, "CANONICAL_BYPASSED": {"type": "integer", "minimum": 0},
            "DUPLICATED": {"type": "integer", "minimum": 0}, "CONTRADICTORY": {"type": "integer", "minimum": 0},
            "MISSING": {"type": "integer", "minimum": 0}, "INTENTIONALLY_EXCEPTIONAL": {"type": "integer", "minimum": 0},
            "PROVISIONAL_OVERLAY": {"type": "integer", "minimum": 0}, "NOT_PRESENT": {"type": "integer", "minimum": 0},
            "SUPERSEDED": {"type": "integer", "minimum": 0}, "UNCLASSIFIED": {"type": "integer", "const": 0}
          }
        },
        "digest": {"$ref": "#/$defs/digest"},
        "vocabulary": {
          "type": "object", "additionalProperties": false,
          "required": ["ConversationCommit", "EffectState", "FinalDelivery", "RpcResponseDelivery", "SendOutcome", "SendState", "Settlement"],
          "properties": {
            "ConversationCommit": {"$ref": "#/$defs/enumMembers"}, "EffectState": {"$ref": "#/$defs/enumMembers"},
            "FinalDelivery": {"$ref": "#/$defs/enumMembers"}, "RpcResponseDelivery": {"$ref": "#/$defs/enumMembers"},
            "SendOutcome": {"$ref": "#/$defs/enumMembers"}, "SendState": {"$ref": "#/$defs/enumMembers"},
            "Settlement": {"$ref": "#/$defs/enumMembers"}
          }
        },
        "coverage_assessments": {
          "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
          "items": {"$ref": "#/$defs/vocabularyCoverageAssessment"}
        },
        "constant_metadata_notes": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/constantMetadataNote"}
        },
        "observations": {"type": "array", "items": {"$ref": "#/$defs/deliveryObservation"}}
      }
    },
    "vocabularyCoverageAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["field_name", "type_name", "vocabulary_values", "observed_values", "missing_values", "status", "reason", "owner", "next_gate"],
      "properties": {
        "field_name": {"enum": ["conversation_commit", "effect_state", "final_delivery", "rpc_response_delivery", "send_outcome", "send_state", "settlement", "request_task_state", "child_work_state", "invocation_outcomes"]},
        "type_name": {"enum": ["ConversationCommit", "EffectState", "FinalDelivery", "RpcResponseDelivery", "SendOutcome", "SendState", "Settlement", "RequestTaskState", "ChildWorkState", "CancellationInvocationOutcome"]},
        "vocabulary_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observed_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_values": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["FULLY_OBSERVED", "SCOPED_OUT"]},
        "reason": {"oneOf": [{"$ref": "#/$defs/contentFreeText"}, {"type": "null"}]},
        "owner": {"oneOf": [{"const": "P11-FEAT-ACP-RUNTIME-HARDENING"}, {"type": "null"}]},
        "next_gate": {"oneOf": [{"$ref": "#/$defs/contentFreeText"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "FULLY_OBSERVED"}}, "required": ["status"]},
          "then": {
            "properties": {
              "missing_values": {"maxItems": 0},
              "reason": {"type": "null"}, "owner": {"type": "null"}, "next_gate": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "SCOPED_OUT"}}, "required": ["status"]},
          "then": {
            "properties": {
              "missing_values": {"minItems": 1},
              "reason": {"$ref": "#/$defs/contentFreeText"},
              "owner": {"const": "P11-FEAT-ACP-RUNTIME-HARDENING"},
              "next_gate": {"$ref": "#/$defs/contentFreeText"}
            }
          }
        }
      ]
    },
    "constantMetadataNote": {
      "type": "object", "additionalProperties": false,
      "required": ["field_name", "constant_value", "claim_status", "reason"],
      "properties": {
        "field_name": {"enum": ["classification", "complete", "contradiction"]},
        "constant_value": {"oneOf": [{"type": "string"}, {"type": "boolean"}, {"type": "null"}]},
        "claim_status": {"const": "NOT_A_VOCABULARY_CLAIM"},
        "reason": {"$ref": "#/$defs/contentFreeText"}
      }
    },
    "enumMembers": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "taskSupervisionSite": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "line", "symbol", "kind", "reference", "source_baseline", "conceptual_id"],
      "properties": {
        "path": {"$ref": "#/$defs/contentFreeText"},
        "line": {"type": "integer", "minimum": 1},
        "symbol": {"$ref": "#/$defs/contentFreeText"},
        "kind": {"enum": ["TASK_CREATE", "CANCELLATION_POINT"]},
        "reference": {"$ref": "#/$defs/contentFreeText"},
        "source_baseline": {"enum": ["merged", "overlay"]},
        "conceptual_id": {"type": "string", "pattern": "^h3-[0-9a-f]{16}$"}
      }
    },
    "taskUnitRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["conceptual_id", "creator", "owner", "registration_point", "cancellation_source", "join_or_settlement", "escape_path", "classification"],
      "properties": {
        "conceptual_id": {"type": "string", "pattern": "^h3-[0-9a-f]{16}$"},
        "creator": {"$ref": "#/$defs/contentFreeText"},
        "owner": {"$ref": "#/$defs/contentFreeText"},
        "registration_point": {"$ref": "#/$defs/contentFreeText"},
        "cancellation_source": {"$ref": "#/$defs/contentFreeText"},
        "join_or_settlement": {"$ref": "#/$defs/contentFreeText"},
        "escape_path": {"$ref": "#/$defs/contentFreeText"},
        "classification": {"enum": ["OWNED", "ESCAPED_CHILD", "INCOMPLETE"]}
      }
    },
    "ownershipSite": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "line", "symbol", "role", "reference", "source_baseline", "conceptual_id"],
      "properties": {
        "path": {"$ref": "#/$defs/contentFreeText"},
        "line": {"type": "integer", "minimum": 1},
        "symbol": {"$ref": "#/$defs/contentFreeText"},
        "role": {"enum": ["REGISTRATION", "TASK_GROUP", "CALLBACK", "TIMEOUT", "CANCELLATION_CATCH", "JOIN", "TASK_SET_MUTATION"]},
        "reference": {"$ref": "#/$defs/contentFreeText"},
        "source_baseline": {"enum": ["merged", "overlay"]},
        "conceptual_id": {"type": "string", "pattern": "^h3-[0-9a-f]{16}$"}
      }
    },
    "cancellationObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["cancellation_point_id", "source_citations", "executed_definition_citations", "seed", "seed_source", "anchor_commit", "concurrency_level", "phase", "cancellation_invocation_count", "invocation_outcomes", "request_task_state", "child_work_state", "final_delivery", "conversation_commit", "effect_state", "cancelled_error_preserved", "complete"],
      "properties": {
        "cancellation_point_id": {"type": "string", "pattern": "^h3-[0-9a-f]{16}$"},
        "source_citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentFreeText"}},
        "executed_definition_citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentFreeText"}},
        "seed": {"type": "integer", "minimum": 0},
        "seed_source": {"enum": ["frozen-literal", "commit-derived"]},
        "anchor_commit": {"$ref": "#/$defs/commit"},
        "concurrency_level": {"enum": [1, 2, 4, 8]},
        "phase": {"enum": ["pre-start", "running", "delivery", "settlement", "teardown"]},
        "cancellation_invocation_count": {"type": "integer", "minimum": 1, "maximum": 8},
        "invocation_outcomes": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
        "request_task_state": {"enum": ["cancelled", "completed"]},
        "child_work_state": {"type": "string", "minLength": 1},
        "final_delivery": {"type": "string", "minLength": 1},
        "conversation_commit": {"type": "string", "minLength": 1},
        "effect_state": {"type": "string", "minLength": 1},
        "cancelled_error_preserved": {"type": "boolean"},
        "complete": {"const": true}
      }
    },
    "cancellationScheduleObservations": {
      "type": "object", "additionalProperties": false,
      "required": ["literal_seeds", "derived_seed_count_per_family", "derived_seed_anchor_commit", "concurrency_levels", "cancellation_point_count", "derived_control_schedule_count", "derived_race_schedule_count", "total_observation_count", "complete_observation_count", "observation_closure_status", "vocabulary_coverage_status", "digest", "vocabulary", "coverage_assessments", "observations"],
      "properties": {
        "literal_seeds": {"const": [0, 1, 42, 18446744073709551615]},
        "derived_seed_count_per_family": {"const": 256},
        "derived_seed_anchor_commit": {"$ref": "#/$defs/commit"},
        "concurrency_levels": {"const": [1, 2, 4, 8]},
        "cancellation_point_count": {"type": "integer", "minimum": 1},
        "derived_control_schedule_count": {"type": "integer", "minimum": 1},
        "derived_race_schedule_count": {"type": "integer", "minimum": 1},
        "total_observation_count": {"type": "integer", "minimum": 1},
        "complete_observation_count": {"type": "integer", "minimum": 1},
        "observation_closure_status": {"const": "FULLY_STRUCTURALLY_CLOSED"},
        "vocabulary_coverage_status": {"enum": ["FULLY_OBSERVED", "PARTIAL_WITH_SCOPE_OUTS"]},
        "digest": {"$ref": "#/$defs/digest"},
        "vocabulary": {
          "type": "object", "additionalProperties": false,
          "required": ["RequestTaskState", "ChildWorkState", "FinalDelivery", "ConversationCommit", "EffectState", "CancellationInvocationOutcome"],
          "properties": {
            "RequestTaskState": {"$ref": "#/$defs/enumMembers"},
            "ChildWorkState": {"$ref": "#/$defs/enumMembers"},
            "FinalDelivery": {"$ref": "#/$defs/enumMembers"},
            "ConversationCommit": {"$ref": "#/$defs/enumMembers"},
            "EffectState": {"$ref": "#/$defs/enumMembers"},
