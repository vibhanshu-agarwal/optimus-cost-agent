{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimus.local/schemas/plan-11-26-runtime-audit-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "merged_commit", "overlay_commit", "binding_commit", "baseline_reconciliation_status",
    "running_artifact_provenance", "static_audit_status", "runtime_characterization_status", "live_redis_status",
    "acpx_status", "additional_client_status", "zed_status", "live_interoperability_status",
    "unclassified_finding_count", "finding_counts_by_classification", "findings", "discovered_multipliers",
    "computed_run_cost", "gate_status"
  ],
  "allOf": [{
    "if": {
      "anyOf": [
        {"properties": {"live_redis_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["live_redis_status"]},
        {"properties": {"acpx_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["acpx_status"]},
        {"properties": {"additional_client_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["additional_client_status"]},
        {"properties": {"zed_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["zed_status"]},
        {"properties": {"live_interoperability_status": {"enum": ["PARTIAL", "COMPLETE"]}}, "required": ["live_interoperability_status"]}
      ]
    },
    "then": {
      "required": ["binding_commit", "running_artifact_provenance"],
      "properties": {
        "binding_commit": {"$ref": "#/$defs/commit"},
        "running_artifact_provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }],
  "properties": {
    "schema_version": {"const": "plan-11-26-runtime-audit-v1"},
    "merged_commit": {"$ref": "#/$defs/commit"},
    "overlay_commit": {"$ref": "#/$defs/commit"},
    "binding_commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
    "baseline_reconciliation_status": {"type": "string", "minLength": 1},
    "running_artifact_provenance": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/provenance"}]},
    "static_audit_status": {"$ref": "#/$defs/liveStatus"},
    "runtime_characterization_status": {"$ref": "#/$defs/liveStatus"},
    "live_redis_status": {"$ref": "#/$defs/liveStatus"},
    "acpx_status": {"$ref": "#/$defs/liveStatus"},
    "additional_client_status": {"$ref": "#/$defs/liveStatus"},
    "zed_status": {"$ref": "#/$defs/liveStatus"},
    "live_interoperability_status": {"$ref": "#/$defs/liveStatus"},
    "unclassified_finding_count": {"type": "integer", "minimum": 0},
    "finding_counts_by_classification": {
      "type": "object", "additionalProperties": false,
      "required": ["CANONICAL", "CANONICAL_BYPASSED", "DUPLICATED", "CONTRADICTORY", "MISSING", "INTENTIONALLY_EXCEPTIONAL", "PROVISIONAL_OVERLAY", "NOT_PRESENT", "SUPERSEDED", "UNCLASSIFIED"],
      "properties": {
        "CANONICAL": {"type": "integer", "minimum": 0}, "CANONICAL_BYPASSED": {"type": "integer", "minimum": 0},
        "DUPLICATED": {"type": "integer", "minimum": 0}, "CONTRADICTORY": {"type": "integer", "minimum": 0},
        "MISSING": {"type": "integer", "minimum": 0}, "INTENTIONALLY_EXCEPTIONAL": {"type": "integer", "minimum": 0},
        "PROVISIONAL_OVERLAY": {"type": "integer", "minimum": 0}, "NOT_PRESENT": {"type": "integer", "minimum": 0},
        "SUPERSEDED": {"type": "integer", "minimum": 0}, "UNCLASSIFIED": {"type": "integer", "minimum": 0}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "discovered_multipliers": {
      "type": "object", "additionalProperties": false,
      "required": ["cancellation_points", "queues", "sinks", "close_paths"],
      "properties": {
        "cancellation_points": {"type": "integer", "minimum": 0}, "queues": {"type": "integer", "minimum": 0},
        "sinks": {"type": "integer", "minimum": 0}, "close_paths": {"type": "integer", "minimum": 0}
      }
    },
    "computed_run_cost": {
      "type": "object", "additionalProperties": false,
      "required": ["cancellation_concurrency_levels", "cancellation_schedules", "cancellation_control_schedules", "queue_admissions", "sink_failure_runs", "idempotent_close_invocations", "scenario_p50_ms", "scenario_p95_ms"],
      "properties": {
        "cancellation_concurrency_levels": {"type": "array", "const": [2, 4, 8]},
        "cancellation_schedules": {"type": "integer", "minimum": 0},
        "cancellation_control_schedules": {"type": "integer", "minimum": 0},
        "queue_admissions": {"type": "integer", "minimum": 0},
        "sink_failure_runs": {"type": "integer", "minimum": 0},
        "idempotent_close_invocations": {"type": "integer", "minimum": 0},
        "scenario_p50_ms": {"$ref": "#/$defs/durations"},
        "scenario_p95_ms": {"$ref": "#/$defs/durations"}
      }
    },
    "gate_status": {"enum": ["PASS", "PASS_WITH_FINDINGS", "INCOMPLETE"]}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "liveStatus": {"enum": ["UNRUN", "PARTIAL", "INVALID", "COMPLETE"]},
    "durations": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "finding": {
      "type": "object", "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"baseline_scope": {"const": "binding"}}, "required": ["baseline_scope"]},
        "then": {"properties": {"evidence": {"items": {"properties": {"baseline_scope": {"const": "binding"}}}}}}
      }],
      "required": ["finding_id", "subject", "classification", "baseline_scope", "symbols", "evidence", "owner", "ruling"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1}, "subject": {"type": "string", "minLength": 1},
        "classification": {"enum": ["CANONICAL", "CANONICAL_BYPASSED", "DUPLICATED", "CONTRADICTORY", "MISSING", "INTENTIONALLY_EXCEPTIONAL", "PROVISIONAL_OVERLAY", "NOT_PRESENT", "SUPERSEDED", "UNCLASSIFIED"]},
        "baseline_scope": {"enum": ["merged", "overlay", "both-aligned", "both-divergent", "binding"]},
        "symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "owner": {"type": "string", "minLength": 1}, "ruling": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "baseline_scope", "digest"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "baseline_scope": {"enum": ["merged", "overlay", "both-aligned", "both-divergent", "binding"]},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_commit", "executable_path", "executable_sha256", "package_name", "package_version", "package_metadata_sha256", "build_manifest_sha256", "embedded_commit", "embedded_commit_sha256", "launcher_sha256", "client_provenance", "environment_fingerprint"],
      "properties": {
        "binding_commit": {"$ref": "#/$defs/commit"}, "executable_path": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/digest"}, "package_name": {"type": "string", "minLength": 1},
        "package_version": {"type": "string", "minLength": 1}, "package_metadata_sha256": {"$ref": "#/$defs/digest"},
        "build_manifest_sha256": {"$ref": "#/$defs/digest"}, "embedded_commit": {"$ref": "#/$defs/commit"},
        "embedded_commit_sha256": {"$ref": "#/$defs/digest"}, "launcher_sha256": {"$ref": "#/$defs/digest"},
        "client_provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version", "path", "sha256", "metadata_sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"},
            "metadata_sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "environment_fingerprint": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
